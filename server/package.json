{
  "name": "debridstreamer-server",
  "private": true,
  "version": "2.3.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.cjs",
    "build": "npm run typecheck && node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('esbuild').buildSync({ entryPoints: ['src/index.ts'], bundle: true, platform: 'node', format: 'cjs', target: 'node24', outfile: 'dist/index.cjs' })\"",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "bittorrent-tracker": "file:vendor/bittorrent-tracker-disabled",
    "fastify": "^5.8.5",
    "k-rpc": "5.1.0",
    "utp-native": "file:vendor/utp-native-disabled",
    "webtorrent": "^3.0.21",
    "webrtc-polyfill": "file:vendor/webrtc-polyfill-disabled",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/webtorrent": "^0.109.10",
    "esbuild": "^0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "find-my-way": "9.7.0"
  }
}
