-        rm -f "$dest"
-        exit 1
-    fi
+    curl --proto '=https' --tlsv1.2 -fsSL --retry 3 --retry-delay 5 \
+        --max-filesize "$SOURCE_ARCHIVE_MAX_BYTES" -o "$temporary" "$url"
+    verify_source_archive "$temporary" || exit 1
+    mv "$temporary" "$dest"
+    trap - RETURN
